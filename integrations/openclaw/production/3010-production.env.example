# /opt/kido-recruiter-prod/3010-production.env — 600 root. KHÔNG chứa secret (secret ở 3010-g8.env / .env).
# activate-g8.sh prod nạp mọi khoá RECRUITMENT_* trong file này vào 3010 SAU KHI g8-owner-go.py authorize-prod
# đã tạo uỷ quyền GO PROD trong DB. Hạn mức phải KHỚP đúng GO PROD Owner đã duyệt (authorize-prod kiểm).
# Hạn mức hiệu lực = min(file này, uỷ quyền DB) — sửa file không nới được hạn mức.

RECRUITMENT_PRODUCTION_MODE=true
RECRUITMENT_PILOT_MODE=false
RECRUITMENT_ZALO_DISPATCH_GRANT_REQUIRED=false
# true: sender chạy; vẫn không gửi khi chưa có uỷ quyền GO PROD và khi Gửi Zalo đang dừng khẩn (HR mở lại).
RECRUITMENT_ZALO_OUTBOUND_ENABLED=true
RECRUITMENT_AI_ENABLED=true
RECRUITMENT_WORKER_ENABLED=true

# Ngày đầu — SYSTEM OWNER quyết định F (18/10/2026)
RECRUITMENT_ZALO_MAX_REQUESTS_PER_RECIPIENT_DAY=3
RECRUITMENT_ZALO_MAX_REQUESTS_PER_DAY=20
RECRUITMENT_ZALO_DAILY_COST_BUDGET_VND=0
RECRUITMENT_ZALO_MONTHLY_COST_BUDGET_VND=0
# Chỉ Tin Tư vấn miễn phí: gửi trong 48 giờ kể từ tin user_send_text gần nhất của ứng viên.
RECRUITMENT_ZALO_INTERACTION_WINDOW_HOURS=48
RECRUITMENT_ZALO_FREE_WINDOW_HOURS=48
# Đơn giá ước tính một tin tính phí (VND, > 0). Ngân sách 0 ⇒ không tin tính phí nào được gửi.
RECRUITMENT_ZALO_ESTIMATED_PAID_MESSAGE_COST_VND=<don-gia-hien-hanh>

# Zalo -224 (OA thiếu quyền gói dịch vụ) → tin FAILED + dừng khẩn outbound + cảnh báo CRITICAL.
RECRUITMENT_ZALO_OA_BLOCKING_ERRORS=-224
# Tin HR chờ gửi quá hạn → không gửi muộn (FAILED + cảnh báo).
RECRUITMENT_HR_MESSAGE_TTL_MINUTES=60
