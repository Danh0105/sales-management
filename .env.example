# Required in production. Keep this value on the backend only.
ZALO_APP_SECRET=

# Absolute public origin used in avatarUrl responses (no trailing slash).
# Leave empty to return a relative /uploads/avatars/... URL.
PUBLIC_BASE_URL=

# Optional; defaults to <project>/uploads/avatars.
AVATAR_UPLOAD_DIR=

# Optional; defaults to <project>/uploads/lesson-images.
LESSON_IMAGE_UPLOAD_DIR=

# Đọc ảnh thời khoá biểu (POST /timetable-import). Bỏ trống thì các endpoint
# khác vẫn chạy bình thường, riêng /timetable-import trả 503 kèm code
# TIMETABLE_AI_NOT_CONFIGURED.
OPENAI_API_KEY=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

# Optional; defaults to gpt-5.6-terra.
OPENAI_TIMETABLE_MODEL=gpt-5.6-terra

# ---------------------------------------------------------------------------
# Báo động "giáo viên chưa check-in" (gửi cho Giáo vụ & Nhân sự)
# ---------------------------------------------------------------------------

# Số phút báo trước giờ vào tiết. Bỏ trống = 5. Nhận 1..120.
TEACHING_CHECKIN_ALERT_LEAD_MINUTES=5
TEACHING_CHECKIN_ALERT_LATE_MINUTES=10

# Gửi thêm qua Zalo OA. =1 để bật, bỏ trống/khác = tắt.
# Chỉ tới được người đã có `employee.zalo_user_id` (ID do OA cấp, không phải số
# điện thoại). Thông báo trong app và push chạy độc lập với cờ này.
TEACHING_CHECKIN_ALERT_ZALO=

# Các thông báo giảng dạy khác (lịch dạy mới, xác nhận/từ chối buổi, báo giảng,
# xin thay giáo viên, đổi vị trí...) mặc định BẬT gửi kèm Zalo OA cho người đã
# có `employee.zalo_user_id`. Tắt khẩn bằng =0 nếu Zalo OA gặp sự cố.
# TEACHING_NOTIFICATION_ZALO=0

# ---------------------------------------------------------------------------
# Webhook Zalo OA — nhân viên nhắn số điện thoại cho OA để tự liên kết Zalo
# Khai URL này ở Zalo OA console: https://<domain>/zalo/oa/webhook
# ---------------------------------------------------------------------------

# Secret Key của OA (mục Thông tin OA trong console). Bỏ trống thì lấy tạm
# ZALO_APP_SECRET; không có cả hai thì webhook bị từ chối — cố ý, vì endpoint
# này ghi thẳng vào hồ sơ nhân viên.
ZALO_OA_SECRET_KEY=

# =0 để tắt kiểm tra chữ ký. CHỈ dùng lúc đang dò cấu hình, tắt xong nhớ bật lại.
ZALO_OA_WEBHOOK_VERIFY=

# Tầng lạnh ảnh chấm công/báo giảng (bỏ trống = chỉ dùng VPS)
LESSON_IMAGE_ARCHIVE_DIR=
LESSON_IMAGE_ARCHIVE_TIMEOUT_MS=3000
LESSON_IMAGE_ARCHIVE_COOLDOWN_MS=30000

# Tầng lạnh file hợp đồng/BBCS/ảnh bàn giao chính sách (bỏ trống = chỉ dùng VPS)
POLICY_CONTRACT_ARCHIVE_DIR=
POLICY_CONTRACT_ARCHIVE_TIMEOUT_MS=3000
POLICY_CONTRACT_ARCHIVE_COOLDOWN_MS=30000
